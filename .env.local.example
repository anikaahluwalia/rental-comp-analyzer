# Copy to .env.local and fill in as you wire things up.

# -- Session signing (swap the mock cookie layer for iron-session / NextAuth) --
SESSION_SECRET=replace_with_32_plus_random_chars

# -- Database (Supabase / Neon / Railway Postgres) --
DATABASE_URL=

# -- Anthropic API key (for the natural-language query feature) --
ANTHROPIC_API_KEY=

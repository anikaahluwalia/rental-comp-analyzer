# Copy to .env.local. Keys are server-only; never use NEXT_PUBLIC_ prefixes.

# Existing scraping transport. Without a key, direct fetch may be blocked.
FIRECRAWL_KEY=
# Optional existing alternative transport.
SCRAPERAPI_KEY=

# Empty means deterministic query fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
